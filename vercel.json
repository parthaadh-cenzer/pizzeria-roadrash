{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/client",
  "functions": {
    "api/relay.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/relay/:path*", "destination": "/api/relay" },
    { "source": "/r/:code", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/runtime-assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/runtime-assets/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(sw.js|index.html|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
